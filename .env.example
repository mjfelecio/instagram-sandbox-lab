# Instagram Sandbox Lab — safe configuration example.
# Copy to `.env.local` (git-ignored) and fill in real values there.
# Never paste credentials into chat, logs, commits, or screenshots.
#
# Where values come from (Meta App Dashboard):
# - Create a Business-type app, add product Instagram > API setup with Instagram login.
# - Complete "Set up Instagram business login": you get an Instagram App ID and
#   Instagram App Secret (App Dashboard > Instagram > API setup with Instagram
#   login > 3. Set up Instagram business login > Business login settings).
# - Add OAuth redirect URIs there (exact match, see README). The dev server prints
#   the exact URI to register: <public-origin>/auth/instagram/callback
# - Add a professional Instagram test account (Business or Creator) under App Roles
#   or generate a token via API setup for your own account. Personal accounts cannot
#   authorize media/Insights.

# Instagram App ID (numeric string) from Business login settings.
INSTAGRAM_APP_ID=

# Instagram App Secret from Business login settings. Server-side only, never exposed.
INSTAGRAM_APP_SECRET=

# Comma-separated scopes to request. Minimum read-only set validated by research:
# instagram_business_basic = identity + owned media + basic media fields
# instagram_business_manage_insights = media Insights (views/reach/likes/comments/shares/saves/total_interactions)
# Do not add content_publish / manage_comments / manage_messages unless you prove the read path needs them.
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights

# Graph API version validated by research. Default v25.0 (documented 2026-02-18,
# examples verified 2026-09-29). v26.0 exists (released 2026-07-29); override only
# after verifying metric names against official docs.
INSTAGRAM_API_VERSION=v25.0

# Local loopback server port. TikTok lab uses 5179; Instagram uses 5180 so both can run.
PORT=5180

# Optional: fixed public origin (e.g. a reserved ngrok static domain).
# When set, `npm run dev` will NOT start ngrok. Register this origin plus
# /auth/instagram/callback in the Meta dashboard and use it for both the UI
# and the OAuth callback.
# INSTAGRAM_PUBLIC_ORIGIN=

# Optional: reserved ngrok domain for the dedicated tunnel (no random URL).
# NGROK_DOMAIN=

# Optional: local ngrok agent API port for THIS app's tunnel.
# Default: first free port in 4040-4049. Never repoints unrelated tunnels.
# NGROK_API_PORT=
